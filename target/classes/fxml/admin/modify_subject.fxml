<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.admin.controller.AdminModifySubjectPopUpController"
      stylesheets="@../../css/styles.css"
      styleClass="background-pane"
      prefWidth="400.0" prefHeight="250.0">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Modify Academic Level" textFill="#6f2e2e">
        <font>
            <Font name="System Bold" size="20.0"/>
        </font>
    </Label>

    <ComboBox fx:id="academicLevelComboBox" prefWidth="300.0" promptText="Select Academic Level" />

    <HBox alignment="CENTER">
        <Button fx:id="modifySubjectButton"
                text="Modify Subject"
                textFill="#FFFFFF"
                onMouseEntered="#modifySubjectButtonHovered" onMouseExited="#modifySubjectButtonExited"
                prefWidth="150.0" prefHeight="30.0"
                style="-fx-background-color: #6F2E2E; -fx-border-radius: 30px; -fx-background-radius: 30px;">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
        </Button>
    </HBox>

</VBox>
