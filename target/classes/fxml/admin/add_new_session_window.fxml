<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="620.0" prefWidth="360.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.controller.AdminAddSessionPopUpController">
   <top>
      <HBox alignment="CENTER" prefHeight="47.0" style="-fx-background-color: #6f2e2e;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Add New Session" textFill="WHITE" style="-fx-font-family: 'Trebuchet MS', Helvetica, sans-serif;">
               <font>
                  <Font name="System Bold" size="24.0"/>
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20" bottom="20" left="40" right="40"/>
         </padding>
         <children>
            <VBox spacing="6" alignment="CENTER_LEFT">
               <children>
                  <Label text="Tutor ID">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <ComboBox fx:id="tutorComboBox" prefWidth="250.0"/>

                  <Label text="Date">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <DatePicker fx:id="datePicker" prefWidth="250.0" styleClass="background-pane" stylesheets="@../../css/styles.css"/>

                  <Label text="Start Time">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <ComboBox fx:id="startTimeComboBox" prefWidth="250.0"/>

                  <Label text="Duration">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <ComboBox fx:id="durationComboBox" prefWidth="250.0"/>

                  <Label text="Subject">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <ComboBox fx:id="subjectComboBox" prefWidth="250.0"/>

                  <Label text="Session Mode">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <ComboBox fx:id="sessionModeComboBox" prefWidth="250.0"/>

                  <Label text="Session Type">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <ComboBox fx:id="sessionTypeComboBox" prefWidth="250.0"/>

                  <Label text="Session Price">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <TextField fx:id="sessionPriceTextField" prefWidth="250.0" promptText="Enter price" styleClass="background-pane" stylesheets="@../../css/styles.css"/>

                  <Label text="Max Number of Students">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <TextField fx:id="maxStudentsTextField" prefWidth="250.0" promptText="Enter maximum students" styleClass="background-pane" stylesheets="@../../css/styles.css"/>
               </children>
            </VBox>
            <!-- Now the button is part of the same VBox and will appear right after the fields -->
            <Button fx:id="addSessionWindowButton" mnemonicParsing="false" onMouseEntered="#addSessionButtonHovered" onMouseExited="#addSessionButtonExited" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #6f2e2e; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Add Session" textFill="#6f2e2e">
               <font>
                  <Font name="System Bold" size="14.0"/>
               </font>
            </Button>
         </children>
      </VBox>
   </center>
</BorderPane>
