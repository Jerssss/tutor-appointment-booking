<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="250.0" prefWidth="360.0" styleClass="background-pane" stylesheets="@../../css/styles.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.admin.controller.AdminModifyLessonPlanPopUpController">
    <top>
        <HBox alignment="CENTER" prefHeight="47.0" style="-fx-background-color: #6f2e2e;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Modify Lesson Plan" textFill="WHITE"
                       style="-fx-font-family: 'Trebuchet MS', Helvetica, sans-serif;">
                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="12" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="35" bottom="40" left="40" right="40"/>
            </padding>
            <children>
                <VBox spacing="10" alignment="CENTER_LEFT">
                    <children>

                        <Label text="Lesson Plan Visibility">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="lessonPlanVisibilityComboBox" prefWidth="300.0" promptText="Select Lesson Plan Visibility"/>
                    </children>
                </VBox>
                <Button fx:id="modifyLessonPlanButton" text="Modify Lesson Plan"  textFill="#FFFFFF"  onMouseEntered="#modifyLessonPlanButtonHovered" onMouseExited="#modifyLessonPlanButtonExited"  prefWidth="150.0" prefHeight="30.0"  style="-fx-background-color: #6F2E2E; -fx-border-radius: 30px; -fx-background-radius: 30px;">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>