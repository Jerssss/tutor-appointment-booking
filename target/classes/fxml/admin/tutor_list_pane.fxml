<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.view.AdminViewTutorView">
   <children>
      <VBox alignment="CENTER" prefHeight="62.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="338.0">
                     <children>
                        <Label fx:id="viewResLabel" text="Tutor List" textFill="#6f2e2e">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="209.0" spacing="20.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="256.0">
                           <children>
                              <TextField fx:id="searchResTextField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="30.0" prefWidth="208.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="236.0">
                     <children>
                        <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#refreshButtonHovered" onMouseExited="#refreshButtonExited" prefHeight="26.0" prefWidth="110.0" style="-fx-background-color: #6F2E2E; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Button>
                        <Button fx:id="addTutorButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#addTutorButtonHovered" onMouseExited="#addTutorButtonExited" prefHeight="26.0" prefWidth="110.0" style="-fx-background-color: #ffffff; -fx-border-color: #6F2E2E; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Add Tutor" textFill="#6f2e2e">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="484.0" prefWidth="805.0">
         <children>
            <TableView fx:id="tutorTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="472.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
               <columns>
                  <TableColumn fx:id="tutorIdColumn" editable="false" prefWidth="95.99999237060547" resizable="false" text="Tutor ID" />
                  <TableColumn fx:id="firstNameColumn" editable="false" prefWidth="74.66667175292969" resizable="false" text="First Name" />
                  <TableColumn fx:id="lastNameColumn" editable="false" prefWidth="85.0" resizable="false" text="Last Name" />
                  <TableColumn fx:id="phoneNoColumn" editable="false" prefWidth="104.33334350585938" resizable="false" text="Phone No." />
                  <TableColumn fx:id="emailColumn" editable="false" prefWidth="144.33331298828125" resizable="false" text="Email" />
                  <TableColumn fx:id="expertiseColumn" editable="false" prefWidth="193.66671752929688" resizable="false" text="Expertise" />
                  <TableColumn fx:id="optionColumn" editable="false" prefWidth="107.3333740234375" resizable="false" text="Option" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

         </children>
      </VBox>
   </children>
</VBox>
