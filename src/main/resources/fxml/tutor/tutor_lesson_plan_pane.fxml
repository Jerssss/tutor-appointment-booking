<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.tutor.view.TutorViewLessonPlanView">
    <children>
        <VBox prefHeight="74.0" prefWidth="805.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="418.0">
                            <children>
                                <Label fx:id="studResTitleLabel" prefHeight="43.0" prefWidth="298.0" text="Lesson Plan" textFill="#6f2e2e">
                                    <font>
                                        <Font name="System Bold" size="29.0" />
                                    </font>
                                </Label>
                            </children>
                            <HBox.margin>
                                <Insets left="9.0" />
                            </HBox.margin>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="241.0" spacing="10.0">
                            <children>
                                <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="278.0">
                                    <HBox.margin>
                                        <Insets right="5.0" />
                                    </HBox.margin>
                                </StackPane>
                                <TextField fx:id="searchStudResTextField" prefHeight="30.0" prefWidth="500.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="248.0" spacing="10.0">
                            <children>
                                <StackPane prefHeight="74.0" prefWidth="197.0">
                                    <children>
                                        <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#refreshButtonHovered" onMouseExited="#refreshButtonExited" prefHeight="26.0" prefWidth="98.0" style="-fx-background-color: #6F2E2E; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </StackPane>
                                <StackPane prefHeight="74.0" prefWidth="197.0">
                                    <children>
                                        <Button fx:id="addLessonPlanButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onMouseEntered="#addLessonPlanButtonHovered" onMouseExited="#addLessonPlanButtonExited" prefHeight="26.0" prefWidth="114.0" style="-fx-background-color: #6F2E2E; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Add Lesson Plan" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <TabPane fx:id="lessonPlanTabPane" stylesheets="@../../css/tablestyles.css" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="lessonPlanTab" text="Lesson Plan">
                    <content>
                        <AnchorPane>
                            <children>
                                <TableView fx:id="lessonPlanListTableView" editable="true" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="805.0" style="-fx-font-size: 13;">
                                    <columns>
                                        <TableColumn fx:id="courseColumn" minWidth="60.0" prefWidth="60.0" text="Course" />
                                        <TableColumn fx:id="subjectIDColumn" minWidth="60.0" prefWidth="60.0" text="Subject No." />
                                        <TableColumn fx:id="subjectColumn" minWidth="90.0" prefWidth="90.0" text="Subject" />
                                        <TableColumn fx:id="objectivesColumn" prefWidth="100.0" text="Objectives" />
                                        <TableColumn fx:id="topicsColumn" minWidth="100.0" prefWidth="100.0" text="Topics" />
                                        <TableColumn fx:id="viewMoreColumn" editable="false" prefWidth="90.0" style="-fx-alignment: CENTER;" text="View More" />
                                        <TableColumn fx:id="updateColumn" editable="false" prefWidth="90.0" resizable="false" text="Update" />
                                        <TableColumn fx:id="deleteColumn" editable="false" prefWidth="80.0" resizable="false" text="Delete" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab fx:id="archivedTab" text="Archived Lesson Plan">
                    <content>
                        <AnchorPane>
                            <children>
                                <TableView fx:id="archivedLessonPlanListTableView" editable="true" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="805.0" style="-fx-font-size: 13;">
                                    <columns>
                                        <TableColumn fx:id="archivedCourseColumn" minWidth="60.0" prefWidth="60.0" text="Course" />
                                        <TableColumn fx:id="archivedSubjectIDColumn" minWidth="60.0" prefWidth="60.0" text="Subject No." />
                                        <TableColumn fx:id="archivedSubjectColumn" minWidth="90.0" prefWidth="90.0" text="Subject" />
                                        <TableColumn fx:id="archivedObjectivesColumn" prefWidth="100.0" text="Objectives" />
                                        <TableColumn fx:id="archivedTopicsColumn" minWidth="100.0" prefWidth="100.0" text="Topics" />
                                        <TableColumn fx:id="archivedViewMoreColumn" editable="false" prefWidth="90.0" style="-fx-alignment: CENTER;" text="View More" />
                                        <TableColumn fx:id="archivedUpdateColumn" editable="false" prefWidth="90.0" resizable="false" text="Update" />
                                        <TableColumn fx:id="archivedDeleteColumn" editable="false" prefWidth="80.0" resizable="false" text="Delete" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>