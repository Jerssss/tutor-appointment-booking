                  <TableColumn fx:id="paymentDateColumn" editable="false" prefWidth="110.0" resizable="false" style="-fx-alignment: CENTER;" text="Payment Date" />
                  <TableColumn fx:id="paymentTimeColumn" editable="false" prefWidth="103.33334350585938" resizable="false" style="-fx-alignment: CENTER;" text="Payment Time" />
                  <TableColumn fx:id="paymentMethodColumn" editable="false" prefWidth="132.0" resizable="false" style="-fx-alignment: CENTER;" text="Payment Method" />
                  <TableColumn fx:id="amountColumn" editable="false" prefWidth="114.0" resizable="false" style="-fx-alignment: CENTER;" text="Amount" />
