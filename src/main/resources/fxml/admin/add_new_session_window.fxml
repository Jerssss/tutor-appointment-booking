<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="500.0" prefWidth="500.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.controller.AdminAddSessionPopUpController">
   <top>
      <HBox alignment="CENTER" prefHeight="47.0" style="-fx-background-color: #6f2e2e;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Add New Session" textFill="WHITE" style="-fx-font-family: 'Trebuchet MS', Helvetica, sans-serif;">
               <font>
                  <Font name="System Bold" size="24.0"/>
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20" bottom="30" left="40" right="40"/>
         </padding>
         <children>
            <VBox spacing="6" alignment="CENTER_LEFT">
               <children>
                  <HBox spacing="10" HBox.hgrow="ALWAYS">
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Tutor ID">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="tutorIDComboBox" prefWidth="200.0" promptText="Select tutor" HBox.hgrow="ALWAYS"/>
                     </VBox>
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Tutor Name">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="tutorNameComboBox" prefWidth="200.0" promptText="Select tutor" HBox.hgrow="ALWAYS"/>
                     </VBox>
                  </HBox>

                  <!-- Date -->
                  <Label text="Date">
                     <font>
                        <Font name="System Bold" size="12.0"/>
                     </font>
                  </Label>
                  <VBox fx:id="dateVBox" alignment="CENTER_LEFT" spacing="-8">
                     <DatePicker fx:id="datePicker" prefWidth="250.0" promptText="Choose date" styleClass="background-pane" stylesheets="@../../css/styles.css"/>
                     <!-- Error message will be added below here -->
                     <Label fx:id="dateErrorLabel" text="" textFill="red" style="-fx-font-size: 12px;"/>
                  </VBox>

                  <HBox spacing="10" HBox.hgrow="ALWAYS">
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Start Time">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="startTimeComboBox" prefWidth="150.0" promptText="Start time" HBox.hgrow="ALWAYS"/>
                     </VBox>
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Duration">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="durationComboBox" prefWidth="150.0" promptText="Duration" HBox.hgrow="ALWAYS"/>
                     </VBox>
                  </HBox>

                  <HBox spacing="10" HBox.hgrow="ALWAYS">
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Subject ID">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="subjectIdComboBox" prefWidth="150.0" promptText="Select ID" HBox.hgrow="ALWAYS"/>
                     </VBox>
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Subject Name">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="subjectNameComboBox" prefWidth="150.0" promptText="Select subject" HBox.hgrow="ALWAYS"/>
                     </VBox>
                  </HBox>

                  <!-- Session Mode & Session Type (Side by Side) -->
                  <HBox spacing="10" HBox.hgrow="ALWAYS">
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Session Mode">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="sessionModeComboBox" prefWidth="150.0" promptText="Select mode" HBox.hgrow="ALWAYS"/>
                     </VBox>
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Session Type">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <ComboBox fx:id="sessionTypeComboBox" prefWidth="150.0" promptText="Select type" HBox.hgrow="ALWAYS"/>
                     </VBox>
                  </HBox>

                  <HBox spacing="10" HBox.hgrow="ALWAYS">
                     <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Max Number of Students">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <TextField fx:id="maxStudentsTextField" prefWidth="150.0" promptText="Enter max students" styleClass="background-pane" stylesheets="@../../css/styles.css" HBox.hgrow="ALWAYS"/>
                     </VBox>
                     <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Session Price">
                           <font>
                              <Font name="System Bold" size="12.0"/>
                           </font>
                        </Label>
                        <TextField fx:id="sessionPriceTextField" prefWidth="150.0" promptText="Enter price" styleClass="background-pane" stylesheets="@../../css/styles.css" HBox.hgrow="ALWAYS"/>
                     </VBox>
                  </HBox>
               </children>
            </VBox>

            <!-- Add Button -->
            <Button fx:id="addSessionWindowButton" mnemonicParsing="false" onMouseEntered="#addSessionButtonHovered" onMouseExited="#addSessionButtonExited" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #6f2e2e; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Add Session" textFill="#6f2e2e">
               <font>
                  <Font name="System Bold" size="14.0"/>
               </font>
            </Button>
         </children>
      </VBox>
   </center>
</BorderPane>
