<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TextArea?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="330.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.controller.AdminAddSubjectPopUpController">
   <center>
      <VBox prefHeight="164.0" prefWidth="266.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="500.0" prefWidth="310.0">
               <children>
                  <HBox prefHeight="43.0" prefWidth="290.0">
                     <children>
                        <VBox prefHeight="50.0" prefWidth="290.0" >
                           <children>
                              <Label text="Subject ID">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="subjectIDTextField" editable="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="280.0" stylesheets="@../../css/styles.css">
                                 <styleClass>
                                    <String fx:value="background-pane" />
                                    <String fx:value="text-field2" />
                                 </styleClass>
                              </TextField>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="43.0" prefWidth="290.0">
                     <children>
                        <VBox prefHeight="50.0" prefWidth="290.0">
                           <children>
                              <Label text="Subject Name">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="subjectNameTextField" editable="true" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="280.0" stylesheets="@../../css/styles.css">
                                 <styleClass>
                                    <String fx:value="background-pane" />
                                    <String fx:value="text-field2" />
                                 </styleClass>
                              </TextField>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="250.0" prefWidth="290.0"> <!-- HBox height matches actual space -->
                     <children>
                        <VBox prefHeight="250.0" prefWidth="290.0"> <!-- Give VBox full width and height -->
                           <children>
                              <Label text="Description ">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextArea fx:id="descriptionTextArea" editable="true" wrapText="true"
                                        prefHeight="200.0" prefWidth="290.0">
                                 <styleClass>
                                    <String fx:value="background-pane" />
                                    <String fx:value="text-field2" />
                                 </styleClass>
                              </TextArea>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="43.0" prefWidth="310.0">
                     <children>
                        <VBox prefHeight="43.0" prefWidth="255.0">
                           <children>
                              <Label text="Academic Level">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="academicLevelComboBox" prefHeight="26.0" prefWidth="250.0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets left="20.0" top="20.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </center>
   <top>
      <HBox alignment="CENTER" prefHeight="47.0" prefWidth="310.0" style="-fx-background-color: #6f2e2e;" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" prefHeight="41.0" prefWidth="255.0" style="-fx-font-family: &quot;Trebuchet MS&quot;, Helvetica, sans-serif;" text="Add New Subject" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER" prefHeight="67.0" prefWidth="330.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="addSubjectWindowButton" mnemonicParsing="false" onMouseEntered="#addSubjectButtonHovered" onMouseExited="#addSubjectButtonExited" prefHeight="21.0" prefWidth="150.0" style="-fx-background-color: #ffffff; -fx-border-color: #6f2e2e; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Add Subject" textFill="#6f2e2e">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>
