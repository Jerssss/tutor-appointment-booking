<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="350" prefHeight="250" styleClass="background-pane" stylesheets="@../../../css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="server.ippicker.IPPickerController">
    <top>
        <HBox prefHeight="50.0" style="-fx-background-color: #6F2E2E;" alignment="CENTER">
            <children>
                <Label text="Server IP Picker" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="15" prefWidth="350" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Select IP:" textFill="#6F2E2E" minWidth="80">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="ipComboBox" prefWidth="200" style="-fx-border-color: #6F2E2E; -fx-background-color: WHITE;" />
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Enter IP:" textFill="#6F2E2E" minWidth="80">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="customIPField" prefWidth="200" style="-fx-border-color: #6F2E2E; -fx-background-color: WHITE;" />
                    </children>
                </HBox>
                <HBox alignment="CENTER">
                    <children>
                        <Button fx:id="confirmButton" text="Confirm" onAction="#handleConfirm" prefWidth="100" style="-fx-background-color: WHITE; -fx-border-color: #6F2E2E; -fx-border-radius: 30px; -fx-background-radius: 30px;" textFill="#6F2E2E">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>