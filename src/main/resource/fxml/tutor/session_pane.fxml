<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.tutor.controller.TutorViewSessionListController">
    <children>
        <VBox prefHeight="74.0" prefWidth="805.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="392.0">
                            <children>
                                <Label fx:id="studResTitleLabel" prefHeight="43.0" prefWidth="402.0" text="Session List" textFill="#6f2e2e">
                                    <font>
                                        <Font name="System Bold" size="29.0" />
                                    </font>
                                </Label>
                            </children>
                            <HBox.margin>
                                <Insets left="9.0" />
                            </HBox.margin>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="241.0" spacing="10.0">
                            <children>
                                <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="278.0">
                                    <HBox.margin>
                                        <Insets right="5.0" />
                                    </HBox.margin>
                                </StackPane>
                                  <TextField fx:id="searchStudResTextField" prefHeight="30.0" prefWidth="500.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="121.0" spacing="10.0">
                            <children>
                                <StackPane prefHeight="74.0" prefWidth="197.0">
                                    <children>
                                        <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" prefHeight="26.0" prefWidth="98.0" style="-fx-background-color: #6F2E2E; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
        <TableView fx:id="sessionListTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
            <columns>
                <TableColumn fx:id="sessionNoColumn" editable="false" prefWidth="90.0" resizable="false" text="Session No." />
                <TableColumn fx:id="subjectColumn" editable="false" prefWidth="90.0" resizable="false" text="Subject" />
                <TableColumn fx:id="sessionModeColumn" editable="false" prefWidth="90.0" resizable="false" text="Session Mode" />
                <TableColumn fx:id="dateColumn" editable="false" prefWidth="85.0" resizable="false" text="Date" />
                <TableColumn fx:id="startTimeColumn" editable="false" prefWidth="90.0" resizable="false" text="Start Time" />
                <TableColumn fx:id="endTimeColumn" editable="false" prefWidth="90.0" resizable="false" text="End Time" />
                <TableColumn fx:id="durationColumn" editable="false" prefWidth="80.0" resizable="false" text="Duration" />
                <TableColumn fx:id="statusColumn" editable="false" prefWidth="90.0" resizable="false" text="Status" />
                <TableColumn fx:id="studentColumn" editable="false" prefWidth="90.0" resizable="false" text="View Student" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

    </children>
</VBox>
