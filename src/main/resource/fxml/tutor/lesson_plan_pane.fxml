<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.tutor.view.TutorViewSessionListView">
    <children>
        <VBox prefHeight="74.0" prefWidth="805.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="392.0">
                            <children>
                                <Label fx:id="studResTitleLabel" prefHeight="43.0" prefWidth="402.0" text="Session List" textFill="#6f2e2e">
                                    <font>
                                        <Font name="System Bold" size="29.0" />
                                    </font>
                                </Label>
                            </children>
                            <HBox.margin>
                                <Insets left="9.0" />
                            </HBox.margin>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="241.0" spacing="10.0">
                            <children>
                                <StackPane alignment="CENTER_RIGHT" prefHeight="74.0" prefWidth="278.0">
                                    <HBox.margin>
                                        <Insets right="5.0" />
                                    </HBox.margin>
                                </StackPane>
                                <TextField fx:id="searchStudResTextField" prefHeight="30.0" prefWidth="500.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" prefHeight="74.0" prefWidth="121.0" spacing="10.0">
                            <children>
                                <StackPane prefHeight="74.0" prefWidth="197.0">
                                    <children>
                                        <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" prefHeight="26.0" prefWidth="98.0" style="-fx-background-color: #6F2E2E; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </StackPane>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
        <TableView fx:id="sessionListTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="477.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
            <columns>
                <TableColumn fx:id="courseColumn" prefWidth="130.0" text="Course" />
                <TableColumn fx:id="subjectColumn" prefWidth="130.0" text="Subject" />
                <TableColumn fx:id="objectivesColumn" prefWidth="180.0" text="Objectives" />
                <TableColumn fx:id="topicsColumn" prefWidth="145.0" text="Topics" />
                <TableColumn fx:id="editColumn" editable="false" prefWidth="110.0" resizable="false" text="Update" />
                <TableColumn fx:id="cancelColumn" editable="false" prefWidth="110.0" resizable="false" text="Delete" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
