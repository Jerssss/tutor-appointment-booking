<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.student.controller.ModifyBookingController">
   <children>
      <VBox prefHeight="149.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="514.0">
                     <children>
                        <Label fx:id="modResLabel" text="Modify Booking" textFill="#6f2e2e">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets left="9.0" />
                     </HBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="78.0" prefWidth="205.0" spacing="10.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="75.0" prefWidth="187.0">
                           <children>
                              <TextField fx:id="searchStudResTextField" prefHeight="29.0" prefWidth="195.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="76.0">
                     <children>
                        <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false"  prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #6F2E2E; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
      <VBox alignment="CENTER" prefHeight="419.0" prefWidth="805.0">
         <children>
            <TableView fx:id="modResTableView" focusTraversable="false" minHeight="-Infinity" prefHeight="433.0" prefWidth="805.0" style="-fx-font-size: 13;" stylesheets="@../../css/tablestyles.css">
               <columns>
                  <TableColumn fx:id="roomNumberColumn" editable="false" prefWidth="96.0" resizable="false" text="Course" />
                  <TableColumn fx:id="terminalIDColumn" editable="false" prefWidth="150.0" resizable="false" text="Subject" />
                  <TableColumn fx:id="reservationDateColumn" editable="false" prefWidth="127.0" resizable="false" text="Session Date" />
                  <TableColumn fx:id="startTimeColumn" editable="false" prefWidth="127.0" resizable="false" text="Session Time" />
                  <TableColumn fx:id="endTimeColumn" editable="false" prefWidth="109.0" resizable="false" text="Session Mode" />
                  <TableColumn fx:id="editColumn" editable="false" minWidth="7.0" prefWidth="97.0" resizable="false" text="Edit" />
                  <TableColumn fx:id="cancelColumn" editable="false" minWidth="7.0" prefWidth="94.0" resizable="false" text="Cancel" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <HBox alignment="CENTER_RIGHT" prefHeight="62.0" prefWidth="805.0">
         <children>
            <Button fx:id="saveChangesButton" mnemonicParsing="false" prefHeight="21.0" prefWidth="150.0" style="-fx-background-color: #6F2E2E; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Save Changes" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <HBox.margin>
                  <Insets bottom="17.0" right="17.0" />
               </HBox.margin>
            </Button>
         </children>
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </HBox>
   </children>
</VBox>
