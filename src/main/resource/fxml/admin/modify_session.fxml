<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="420.0" prefWidth="360.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.controller.AdminModifySessionPopUpController">
    <top>
        <HBox alignment="CENTER" prefHeight="47.0" style="-fx-background-color: #6f2e2e;" BorderPane.alignment="CENTER">
            <children>
                <Label text="Modify Session" textFill="WHITE" style="-fx-font-family: 'Trebuchet MS', Helvetica, sans-serif;">
                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="12" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" bottom="60" left="40" right="40"/>
            </padding>
            <children>
                <VBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Session Type">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="sessionTypeComboBox" prefWidth="250.0"/>

                        <Label text="Session Mode">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="sessionModeComboBox" prefWidth="250.0"/>

                        <Label text="Number of Students">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="numberOfStudentsField" prefWidth="250.0" styleClass="background-pane" stylesheets="@../../css/styles.css" />
                        <Label fx:id="numberStudentsErrorLabel" textFill="RED" visible="false" />


                        <Label text="Maximum Number of Students">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="maxNumberOfStudentsField" prefWidth="250.0" styleClass="background-pane" stylesheets="@../../css/styles.css"/>
                        <Label fx:id="maxStudentsErrorLabel" textFill="RED" visible="false" />

                        <Label text="Session Price">
                            <font>
                                <Font name="System Bold" size="12.0"/>
                            </font>
                        </Label>
                        <TextField fx:id="sessionPriceField" prefWidth="250.0" styleClass="background-pane" stylesheets="@../../css/styles.css"/>
                        <Label fx:id="priceErrorLabel" textFill="RED" visible="false" />

                    </children>
                </VBox>

                <Button fx:id="modifySessionButton" mnemonicParsing="false" onMouseEntered="#modifySessionButtonHovered" onMouseExited="#modifySessionButtonExited" prefWidth="160.0" style="-fx-background-color: #ffffff; -fx-border-color: #6f2e2e; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Modify Session" textFill="#6f2e2e">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>
