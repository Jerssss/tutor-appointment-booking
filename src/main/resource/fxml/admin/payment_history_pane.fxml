                  <TableColumn fx:id="paymentTimeColumn" editable="false" prefWidth="105.6666259765625" resizable="false" text="Payment Time" />
                  <TableColumn fx:id="paymentMethodColumn" editable="false" prefWidth="114.33334350585938" resizable="false" text="Payment Method" />
                  <TableColumn fx:id="amountColumn" editable="false" prefWidth="106.66668701171875" resizable="false" text="Amount " />
