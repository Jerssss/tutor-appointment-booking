<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="centerPane" prefHeight="573.0" prefWidth="805.0" styleClass="background-pane" stylesheets="@../../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.admin.controller.AdminViewLessonPlanController">
   <children>
      <VBox prefHeight="74.0" prefWidth="805.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="805.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="56.0" prefWidth="500.0">
                     <children>
                        <Label fx:id="reportsLabel" prefHeight="43.0" prefWidth="322.0" text="Lesson Plans" textFill="#6f2e2e">
                           <font>
                              <Font name="System Bold" size="29.0" />
                           </font>
                           <padding>
                              <Insets left="15.0" />
                           </padding>
                        </Label>
                     </children>
                  </HBox>
                  <HBox prefHeight="56.0" prefWidth="214.0">
                     <children>
                        <StackPane alignment="CENTER_RIGHT" prefHeight="56.0" prefWidth="231.0">
                           <children>
                              <TextField fx:id="searchReportTextField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="29.0" prefWidth="230.0" promptText="Enter keywords..." styleClass="background-pane" stylesheets="@../../css/styles.css" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="56.0" prefWidth="93.0">
                     <children>
                        <Button fx:id="refreshButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" prefHeight="26.0" prefWidth="77.0" style="-fx-background-color: #6f2e2e; -fx-border-color: #ffffff; -fx-border-radius: 30px; -fx-background-radius: 30px;" text="Refresh" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </HBox>
         </children>
      </VBox>

      <!-- Report Tables -->
      <VBox alignment="CENTER" prefHeight="521.0" prefWidth="805.0">
         <children>
            <TabPane fx:id="reportsTabPane" stylesheets="@../../css/tablestyles.css" tabClosingPolicy="UNAVAILABLE">
               <tabs>
                  <Tab fx:id="logReportTab" text="High-school">
                     <content>
                        <AnchorPane>
                           <children>
                              <TableView fx:id="highSchoolTableView" prefHeight="482.0" prefWidth="805.0">
                                 <columns>
                                    <TableColumn fx:id="highSchoolLessonPlanIDColumn" prefWidth="130.0" text="Lesson Plan ID" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="highSchoolSubjectIDColumn" prefWidth="130.0" text="Subject ID" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="highSchoolObjectivesColumn" prefWidth="180.0" text="Objectives" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="highSchoolTopicsColumn" prefWidth="145.0" text="Topics" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="editColumn" editable="false" prefWidth="110.0" resizable="false" text="Update" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="cancelColumn" editable="false" prefWidth="110.0" resizable="false" text="Delete" style="-fx-alignment: CENTER;"/>
                                 </columns>
                              </TableView>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>


                  <Tab fx:id="collegeTab" text=" College ">
                     <content>
                        <AnchorPane>
                           <children>
                              <TableView fx:id="collegeTableView" prefHeight="482.0" prefWidth="805.0">
                                 <columns>
                                    <TableColumn fx:id="collegeLessonPlanIDColumn" prefWidth="130.0" text="Lesson Plan ID" style="-fx-alignment: CENTER;" />
                                    <TableColumn fx:id="collegeSubjectIDColumn" prefWidth="130.0" text="Subject ID" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="collegeObjectivesColumn" prefWidth="180.0" text="Objectives" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="collegeTopicsColumn" prefWidth="145.0" text="Topics" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="editColumn2" editable="false" prefWidth="110.0" resizable="false" text="Update" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="cancelColumn2" editable="false" prefWidth="110.0" resizable="false" text="Delete" style="-fx-alignment: CENTER;"/>
                                 </columns>
                              </TableView>

                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</VBox>
